{
  "name": "alcove",
  "productName": "Alcove",
  "version": "0.1.0",
  "description": "Alcove: a productivity and privacy focused browser",
  "author": "X UP Brands",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "sync-ui": "node scripts/sync-ui.js",
    "start": "npm run sync-ui && electron .",
    "dist": "npm run sync-ui && electron-builder --publish never",
    "check": "node --check main.js && node --check crx.js && node --check md-search.js && node --check preload.js && node --check yt-preload.js && node scripts/check-package.js",
    "notices": "node scripts/third-party.js"
  },
  "build": {
    "appId": "com.xupbrands.alcove",
    "productName": "Alcove",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "crx.js",
      "md-search.js",
      "preload.js",
      "yt-preload.js",
      "ui/**/*",
      "package.json",
      "!**/*.map"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null,
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSCameraUsageDescription": "Websites you allow can use your camera.",
        "NSMicrophoneUsageDescription": "Websites you allow can use your microphone.",
        "NSLocationWhenInUseUsageDescription": "Websites you allow can know your location.",
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "HTML document",
            "CFBundleTypeRole": "Viewer",
            "LSItemContentTypes": [
              "public.html"
            ],
            "LSHandlerRank": "Alternate"
          },
          {
            "CFBundleTypeName": "XHTML document",
            "CFBundleTypeRole": "Viewer",
            "LSItemContentTypes": [
              "public.xhtml"
            ],
            "LSHandlerRank": "Alternate"
          }
        ]
      },
      "artifactName": "Alcove-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeCliInspectArguments": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "onlyLoadAppFromAsar": true,
      "resetAdHocDarwinSignature": true
    },
    "copyright": "Copyright © 2026 Alcove contributors",
    "extraResources": [
      {
        "from": "../LICENSE",
        "to": "LICENSE.alcove.txt"
      },
      {
        "from": "../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "protocols": [
      {
        "name": "Web site",
        "schemes": [
          "http",
          "https"
        ]
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "artifactName": "Alcove-Setup-${version}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.3",
    "adm-zip": "^0.6.1"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mrmx485-sudo/alcove.git"
  }
}
