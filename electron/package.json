{
  "name": "alcove",
  "productName": "Alcove",
  "version": "0.1.0",
  "description": "Alcove: a productivity and privacy focused browser",
  "author": "X UP Brands",
  "main": "main.js",
  "scripts": {
    "sync-ui": "node scripts/sync-ui.js",
    "start": "npm run sync-ui && electron .",
    "dist": "npm run sync-ui && electron-builder"
  },
  "build": {
    "appId": "com.xupbrands.alcove",
    "productName": "Alcove",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "yt-preload.js",
      "ui/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "identity": null,
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSCameraUsageDescription": "Websites you allow can use your camera.",
        "NSMicrophoneUsageDescription": "Websites you allow can use your microphone.",
        "NSLocationWhenInUseUsageDescription": "Websites you allow can know your location."
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.3",
    "adm-zip": "^0.6.1"
  }
}
